# Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_crm?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional; required to enable the corresponding sign-in button)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Legal CRM"

# Object Storage (Milestone 3+)
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email (Milestone 2+)
# RESEND_API_KEY=""

# Stripe (Milestone 6+)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AI (Milestone 4+)
# OPENAI_API_KEY=""

# Redis (Optional — caching, rate limiting)
# REDIS_URL="redis://localhost:6379"
